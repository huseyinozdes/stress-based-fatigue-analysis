@phdthesis{Ozdes2014,
  author    = {Hüseyin Özdeş},
  title     = {The Relationship Between High-Cycle Fatigue and Tensile Properties in Cast Aluminum Alloys},
  school    = {University of North Florida},
  year      = {2014},
  url       = {https://digitalcommons.unf.edu/etd/716/},
  orcid     = {0000-0003-0283-4626},
  abstract  = {Cast aluminum alloys are common in automotive and aerospace applications. This thesis analyzes the link between tensile and fatigue performance of cast aluminum alloys (319, D357, B201, A356-T6), demonstrating that fatigue performance can be predicted from tensile properties using Quality Index (QT), Walker mean-stress correction, and empirical Basquin parameters. The study develops a new method to estimate S-N curves that outperforms existing approaches for aluminum castings.}
}

